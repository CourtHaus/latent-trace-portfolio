    {
      "name": "Briefings",
      "item": [
        {
          "name": "Create Briefing (jurisdiction summary)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retrieval_contract\": \"homicide_jurisdiction_year_summary\",\n  \"filters\": {\n    \"source_year\": 2022,\n    \"source_state\": \"VA\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/briefings",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "briefings"
              ]
            }
          }
        },
        {
          "name": "Create Briefing (incident detail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"retrieval_contract\": \"homicide_incident_detail\",\n  \"filters\": {\n    \"incident_id\": {{incident_id}},\n    \"include_completeness\": false\n  }\n}"
