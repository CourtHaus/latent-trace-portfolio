{
  "info": {
    "name": "CaseSignal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Full API surface for CaseSignal. Set collection variables before running: base_url, api_key (admin key for admin routes), dataset_version_id, incident_id, jurisdiction_id, source_code."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_key",
      "value": "REPLACE_WITH_YOUR_API_KEY"
    },
    {
      "key": "dataset_version_id",
      "value": "1"
    },
    {
      "key": "incident_id",
      "value": "1"
    },
    {
      "key": "jurisdiction_id",
      "value": "1"
    },
    {
      "key": "source_code",
      "value": "FBI_NIBRS"
    },
    {
      "key": "source_year",
      "value": "2022"
    },
    {
      "key": "source_state",
      "value": "VA"
    },
    {
      "key": "ai_briefing_id",
      "value": "1"
    },
    {
      "key": "va_richmond_jurisdiction_id",
      "value": "88"
    },
    {
      "key": "md_baltimore_jurisdiction_id",
      "value": "1262"
    },
    {
      "key": "ca_los_angeles_jurisdiction_id",
      "value": "1344"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Datasets",
      "item": [
        {
          "name": "Current Published Versions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/current?source_code={{source_code}}&source_year={{source_year}}&source_state={{source_state}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "current"
              ],
              "query": [
                {
                  "key": "source_code",
                  "value": "{{source_code}}"
                },
                {
                  "key": "source_year",
                  "value": "{{source_year}}"
                },
                {
                  "key": "source_state",
                  "value": "{{source_state}}"
                }
              ]
            }
          }
        },
        {
          "name": "Latest by State",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/latest-by-state?source_code={{source_code}}",
              "host": [
