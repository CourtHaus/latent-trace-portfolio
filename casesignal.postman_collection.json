              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "latest-by-state"
              ],
              "query": [
                {
                  "key": "source_code",
                  "value": "{{source_code}}"
                }
              ]
            }
          }
        },
        {
          "name": "Dataset Version by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/{{dataset_version_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "{{dataset_version_id}}"
              ]
            }
          }
        },
        {
          "name": "Dataset Coverage",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/{{dataset_version_id}}/coverage",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "{{dataset_version_id}}",
                "coverage"
              ]
            }
          }
        },
        {
          "name": "Field Completeness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/{{dataset_version_id}}/field-completeness",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "{{dataset_version_id}}",
                "field-completeness"
              ]
            }
          }
        },
        {
          "name": "Current Versions + Completeness",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/datasets/current?source_year={{source_year}}&source_state={{source_state}}&include_completeness=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "datasets",
                "current"
              ],
              "query": [
                {
                  "key": "source_year",
                  "value": "{{source_year}}"
                },
                {
                  "key": "source_state",
                  "value": "{{source_state}}"
                },
                {
                  "key": "include_completeness",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
