# Latent Trace local environment configuration.
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
# Required. Set POSTGRES_PASSWORD to any non-trivial value before `docker compose up`.
# docker compose interpolates these into the Postgres container environment.
POSTGRES_USER=casesignal
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
POSTGRES_DB=casesignal
# DATABASE_URL is the libpq URL used by the application to reach Postgres.
# In production, set this explicitly — no default in non-dev environments.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5433/${POSTGRES_DB}

# Supabase prod connection string for the sync_to_supabase.sh script.
# Set this on your operator machine; leave unset in CI / on Cloud Run.
# Format: postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# SUPABASE_DATABASE_URL=

# --- Cold-case data storage ---
# Where downloaded case photos live on disk. Default is "data/photos"
# relative to CWD, which puts photos inside whichever git worktree the
# ingestion or API process is running from. Set this to a stable path
# OUTSIDE any worktree (e.g. /home/user/casesignal-data/photos) so
# `git worktree remove` can't delete your downloaded photos.
# All consumers honor this: the ingestion adapter, the API photo-serving
# endpoint, and scripts/restore_case_photos.py.
#CASESIGNAL_PHOTOS_ROOT=/home/user/casesignal-data/photos

# --- AI backend (OpenAI-compatible endpoint) ---
# Default: local Ollama. Override these three to use any OpenAI-compatible endpoint.
# Hosted endpoints send supplied narratives to that provider; review data handling first.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:14b

# --- Cold-case structured-extraction ---
# Pinned model used by casesignal-extract-cold-cases / extraction worker.
# Must match an OpenAI-compatible model the configured backend can serve.
EXTRACTION_MODEL_ID=qwen3:14b

# --- Geocoding (Google Maps tier) ---
# Optional. When set, the geocoding service inserts a Google tier between
# Census and ZIP-centroid fallback (per PR #66). Cases that Census can't
# resolve but Google can land at 'street' or 'landmark' precision instead
# of falling through to county centroid. Substantial uplift on rural data
# (Wyoming, rural Colorado). Leave empty to disable; ladder degrades to
# Census -> ZIP -> county.
GOOGLE_MAPS_API_KEY=

# --- API service ---
# CSV list of allowed CORS origins for the FastAPI app (the browser origin(s)
# the frontend is served from). Required in non-dev environments — the browser
# cannot call the API from an origin not listed here. Production is the custom
# domain; include the Vercel URL too if you still serve from it.
# Example: https://latenttrace.org,https://www.latenttrace.org
# (The frontend's own NEXT_PUBLIC_SITE_URL is set in the Vercel project, not here.)
FRONTEND_ORIGINS=

# Number of trusted reverse-proxy hops to trust in X-Forwarded-For when
# bucketing per-IP rate limits. 0 (default) trusts nothing and uses the direct
# peer IP — correct for local dev with no proxy. Behind Cloud Run / a load
# balancer, set this to the number of proxies that append to X-Forwarded-For
# (Cloud Run *.run.app is typically 1) so rate buckets key on the real client
# instead of collapsing to the proxy IP. The real client IP is read at index
# -hops from the right, so a client cannot spoof the leftmost entry to evade or
# frame a bucket.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Filesystem root for admin ingestion uploads. Resolved at import time;
# all upload paths must stay strictly inside this directory (path-traversal guard).
INGESTION_UPLOAD_ROOT=/tmp/casesignal_uploads

# --- Supabase Auth / Storage ---
# SUPABASE_URL is server-side and used for Auth token verification and Storage.
SUPABASE_URL=
# Server-side anon or publishable key used by FastAPI to validate Supabase Auth
# access tokens. This is not the service-role key.
SUPABASE_ANON_KEY=
# Public frontend Supabase Auth values used by the Next.js app. These must be
# anon/publishable values, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role remains server-only and is used only for private Storage access.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=case-photos
SUPABASE_STORAGE_PREFIX=

# Python logging level for the API + ETL processes (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Database tuning (defaults shown) ---
# Echo emitted SQL to logs. Useful for debugging; noisy in production.
SQLALCHEMY_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
# 0 disables the per-statement timeout. Default: 30s. Long-running ETL queries
# may need a higher value; the API service deliberately keeps a tight 30s cap.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=casesignal_etl

# --- Polite HTTP scraper (Phase 1+ HTML adapters) ---
# Branded UA used by all scraping adapters. Identifies Latent Trace honestly to
# the source site; do NOT replace with a misrepresenting UA without cause.
# When a specific source's edge filter (e.g. Akamai) blocks the branded UA
# with a generic 4xx, scoping a Firefox-class UA to that adapter run is
# acceptable — surface the decision per the bot-filter-vs-access-denial
# convention. Example one-off override for the NH DOJ source:
#   CASESIGNAL_SCRAPER_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64; rv:124.0) Gecko/20100101 Firefox/124.0" \
#     CASESIGNAL_BYPASS_ROBOTS_HOSTS=www.doj.nh.gov \
#     casesignal-etl --source-key cold_case_nh_doj_2026_05_14
CASESIGNAL_SCRAPER_USER_AGENT="LatentTrace/0.1 (cold-case research; contact: courtney@latenttrace.org)"
CASESIGNAL_SCRAPER_RATE_LIMIT_SECONDS=2.0
CASESIGNAL_SCRAPER_TIMEOUT_SECONDS=30
CASESIGNAL_SCRAPER_MAX_RETRIES=4
# Photo / asset download size cap. Default 25 MB.
CASESIGNAL_SCRAPER_MAX_FETCH_BYTES=26214400
# Comma-separated hosts where polite_http should skip robots.txt fetching.
# Use when robots.txt itself is unreachable (e.g. 403'd at the CDN edge)
# but the underlying content is genuinely public. Set per-run, not global —
# leaving robots.txt enforcement enabled by default is the safer posture.
# Example: CASESIGNAL_BYPASS_ROBOTS_HOSTS=www.doj.nh.gov,another.example.org
CASESIGNAL_BYPASS_ROBOTS_HOSTS=

# --- App environment ---
# Set to "production" for any deployed environment. "dev" is the only value
# that skips strict configuration checks; tests set explicit values. No runtime auth behavior
# is branched on APP_ENV — authentication is always enforced.
APP_ENV=dev

# --- API key HMAC secret ---
# Server-side secret used to HMAC API key plaintext during storage/lookup.
# Required in non-dev environments. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Rotating this invalidates existing API keys; revoke and reissue them.
KEY_HMAC_SECRET=

# --- Error tracking / observability (Sentry) ---
# Backend error reporting for the API and the worker daemons. Fully OPT-IN:
# with SENTRY_DSN unset (the default), all Sentry wiring is a no-op, so dev,
# test, and CI need no Sentry account. Set the DSN in deployed environments.
# Get a DSN from a Sentry project (Settings -> Client Keys (DSN)).
SENTRY_DSN=
# Defaults to APP_ENV when unset; override to label the Sentry environment.
SENTRY_ENVIRONMENT=
# Optional release identifier (e.g. a git SHA) for grouping issues by deploy.
SENTRY_RELEASE=
# Performance-trace sampling. Errors are always captured; traces cost quota,
# so this defaults to 0 (off). Raise (e.g. 0.05) only if you want tracing.
SENTRY_TRACES_SAMPLE_RATE=0
# Worker dead-man's-switch: the extraction worker sends throttled check-ins to
# this Sentry cron monitor (auto-created on first check-in). If the worker
# crashes OR silently hangs, missed check-ins alert. Leave blank to disable.
SENTRY_WORKER_MONITOR_SLUG=

# Frontend analytics (PostHog) is configured in frontend/.env.local — see frontend/.env.local.example.

# Optional API transaction pooler; workers and Alembic retain DATABASE_URL.
API_DATABASE_URL=
# Optional shared rate-limit store for multiple API instances.
RATE_LIMIT_REDIS_URL=
# Operator backup destination; required by scripts/backup_corpus.sh.
BACKUP_BUCKET=
