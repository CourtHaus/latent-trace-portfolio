# Server-only. Never read by client components (enforced by the
# `server-only` import in src/lib/api.ts).
API_BASE_URL=http://localhost:8000
# Split preview deploy example:
# API_BASE_URL=https://<your-cloud-run-api-domain>

# User-facing origin for sitemap + robots. NOT the FastAPI's API_BASE_URL —
# the Next.js Node server hosting the public site. NEXT_PUBLIC_ prefix is
# forward-looking (share buttons etc. may need it on the client).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CARTO map backgrounds (main map and case-detail maps).
# Get a Basemaps key at https://www.carto.com/basemaps/apikey/.
# This browser key is intentionally public. Restrict it to your site origins
# in CARTO's dashboard. Without it, CARTO tiles show an API-key watermark.
# Restart dev after setting it; on Vercel, set it before building/redeploying.
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# PostHog product analytics. If unset, analytics is fully disabled (dev default).
# Get a project API key from https://us.posthog.com → Project settings → "Project API Key" (phc_*).
# This is the public, write-only client key — safe to ship to the browser (the NEXT_PUBLIC_ prefix exposes it intentionally).
# Do NOT use a Personal API Key (phx_*) — those grant read access and must never reach the browser.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingestion host. Defaults to US instance; change to https://eu.i.posthog.com for an EU-region project, or your self-hosted URL.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Auth. The anon key is intentionally public; never use the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret guarding POST /api/revalidate (on-demand cache purge after
# a data sync). Set the SAME value here (Vercel) and in the sync's .env so
# scripts/sync_to_supabase.sh can trigger it. Unset = the route 503s and the
# sync's revalidate step is skipped (safe no-op).
REVALIDATE_SECRET=

# Sentry error tracking (client + server runtimes). Fully OPT-IN: unset = Sentry
# is a no-op everywhere (src/lib/observability/sentry.ts). The DSN is a public
# ingest key (not a secret), so the NEXT_PUBLIC_ prefix is intentional and one
# var configures both runtimes. Get it from a Sentry project's Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Defaults to NODE_ENV when unset; override to label the Sentry environment.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Performance-trace sampling. Errors are always captured; traces cost quota, so
# this defaults to 0 (off). Raise (e.g. 0.05) only if you want tracing.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build-time source-map upload (optional). Set all three to get symbolicated
# stack traces in Sentry; leave unset to skip upload (runtime capture still works).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
