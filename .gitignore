# pyenv
#   For a library or binary, you shouldn't ignore these files, but for a specific project, it can be useful.
# .python-version

# pipenv
#   According to pypa/pipenv#1173, it is recommended not to include env directory in version control.
#   Feel free to uncomment these lines if you use pipenv.
# REPL_HISTORY_STUFF

# poetry
#   Poetry uses pyproject.toml and poetry.lock.
#   Depending on the project, you might want to ignore poetry.lock if it's a library.
#   For apps, it's generally recommended to keep it.

# pdm
#   If PDM is used to manage dependencies:
.pdm-python
.pdm-build/

# PEP 582; used by e.g. github.com/davidhalter/jedi-vim, github.com/pdm-project/pdm
__pypackages__/

