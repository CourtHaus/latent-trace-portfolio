FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE constraints.txt ./
COPY src ./src

# constraints.txt pins the full transitive set so a rebuild ships the exact
# tested versions, not "whatever is latest on PyPI today". Without it, an
# unpinned rebuild pulled sentry-sdk 2.62.0 (RecursionError regression) and
# took prod down (2026-06-15). Regenerate per the header in constraints.txt.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e . -c constraints.txt

# Cloud Run sets PORT at runtime; default to 8000 for local docker runs.
EXPOSE 8000
# NB: we intentionally do NOT pass uvicorn --proxy-headers. The only forwarded
# header we trust is X-Forwarded-Proto (for the https scheme), handled by
# ForwardedProtoMiddleware which touches scope["scheme"] only. uvicorn's
# --proxy-headers would also rewrite the client address from X-Forwarded-For,
# which would let a client spoof the IP the rate-limit fallback uses; the app's
# explicit trusted-hop logic (RATE_LIMIT_TRUSTED_PROXY_HOPS) handles XFF instead.
CMD ["sh", "-c", "exec uvicorn casesignal.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
